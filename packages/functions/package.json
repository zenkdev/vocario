    "firebase-functions": "7.4.0",
    "mime": "4.1.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "firebase-functions-test": "3.5.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10"
  },
  "private": true,
  "version": "0.0.1"
